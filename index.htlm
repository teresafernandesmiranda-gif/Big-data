<div id="nav">
  <button id="bp" onclick="go(-1)" title="← Previous">←</button>
  <span id="sc">01 / 10</span>
  <button id="bn" onclick="go(1)" title="Next →">→</button>
  <span id="timer" onclick="toggleTimer()" title="Click to start/pause">00:00</span>
</div>

<script>
const slides=[...document.querySelectorAll('.slide')];
const N=slides.length;
let cur=0,elapsed=0,timerRunning=false,tiv=null;
const pb=document.getElementById('pb'),sc=document.getElementById('sc'),te=document.getElementById('timer');

function updateUI(){
  pb.style.width=((cur+1)/N*100)+'%';
  sc.textContent=String(cur+1).padStart(2,'0')+' / '+String(N).padStart(2,'0');
  document.getElementById('bp').disabled=cur===0;
  document.getElementById('bn').disabled=cur===N-1;
}

function go(d){
  const nxt=cur+d;
  if(nxt<0||nxt>=N)return;
  slides[cur].classList.remove('active');
  slides[cur].classList.add('exit');
  const prev=cur;
  setTimeout(()=>slides[prev].classList.remove('exit'),380);
  cur=nxt;
  slides[cur].classList.add('active');
  updateUI();
  if(!timerRunning&&elapsed===0)startTimer();
}

function startTimer(){
  timerRunning=true;
  tiv=setInterval(()=>{
    elapsed++;
    te.textContent=String(Math.floor(elapsed/60)).padStart(2,'0')+':'+String(elapsed%60).padStart(2,'0');
    te.className=elapsed>=600?elapsed>=750?'over':'warn':'';
  },1000);
}

function toggleTimer(){
  if(timerRunning){clearInterval(tiv);timerRunning=false;}
  else startTimer();
}

document.addEventListener('keydown',e=>{
  if(['ArrowRight','ArrowDown',' '].includes(e.key)){e.preventDefault();go(1);}
  if(['ArrowLeft','ArrowUp'].includes(e.key)){e.preventDefault();go(-1);}
});

updateUI();
</script>
</body>
</html>
